	Argon is a clean HTML5 theme for LuCI. It is based on luci-theme-material Argon Template

	luci-theme-argon
	Copyright 2020 Jerrykuku <jerrykuku@qq.com>

	Have a bug? Please create an issue here on GitHub!
	https://github.com/jerrykuku/luci-theme-argon/issues

	luci-theme-material:
	Copyright 2015 Lutty Yang <lutty@wcan.in>

	Argon Theme
	https://demos.creative-tim.com/argon-dashboard/index.html

	Licensed to the public under the Apache License 2.0
-#}

{%
	import { access } from 'fs';
	import { cursor } from 'uci';

	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');

	let cfg = cursor();

	//send as HTML5
	http.prepare_content('text/html; charset=UTF-8');

	//Custom settings
	function validColor(value, fallback) {
		return type(value) == 'string' && match(value, /^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$/) ? value : fallback;
	}

	function validNumber(value, fallback, maximum) {
		return type(value) == 'string' && match(value, /^(0|[1-9][0-9]*)(\.[0-9]+)?$/) && +value <= maximum ? value : fallback;
	}

	let mode = 'normal';
	let primary = '#5e72e4';
	let dark_primary = '#483d8b';
	let blur_radius = '10';
	let blur_radius_dark = '10';
	let blur_opacity = '0.5';
	let blur_opacity_dark = '0.5';
	const has_argon_config = access('/etc/config/argon');
	if (has_argon_config) {
		primary = validColor(cfg.get_first('argon', 'global', 'primary'), primary);
		dark_primary = validColor(cfg.get_first('argon', 'global', 'dark_primary'), dark_primary);
		blur_radius = validNumber(cfg.get_first('argon', 'global', 'blur'), blur_radius, 100);
		blur_radius_dark = validNumber(cfg.get_first('argon', 'global', 'blur_dark'), blur_radius_dark, 100);
		blur_opacity = validNumber(cfg.get_first('argon', 'global', 'transparency'), blur_opacity, 1);
		blur_opacity_dark = validNumber(cfg.get_first('argon', 'global', 'transparency_dark'), blur_opacity_dark, 1);
		let configured_mode = cfg.get_first('argon', 'global', 'mode');
		if (configured_mode == 'normal' || configured_mode == 'dark' || configured_mode == 'light')
			mode = configured_mode;
	}
	const bar_color = mode == 'dark' ? dark_primary : primary;

-%}
<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}">

<head>
	{% include("themes/" + theme + "/head_meta", { hostname: hostname, node: node, bar_color: bar_color, media: media }) %}

	<link rel="stylesheet" href="{{ media }}/css/cascade.css{# ?v=PKG_VERSION #}">
	{% if (mode == 'normal'): %}
	<link rel="stylesheet" href="{{ media }}/css/dark.css{# ?v=PKG_VERSION #}" media="(prefers-color-scheme: dark)">
	{% elif (mode == 'dark'): %}
	<link rel="stylesheet" href="{{ media }}/css/dark.css{# ?v=PKG_VERSION #}">
	{% endif %}
	<style title="text/css">
		{% if (has_argon_config): %}
		:root {
			--primary: {{ primary }};
			--dark-primary: {{ dark_primary }};
			--blur-radius:{{ blur_radius }}px;
			--blur-opacity:{{ blur_opacity }};
			--blur-radius-dark:{{ blur_radius_dark }}px;
			--blur-opacity-dark:{{ blur_opacity_dark }};
		}
		{% endif -%}
	</style>
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css}}">
	{% endif -%}
	{% if (css): %}
	<style title="text/css">
		{{ css }}
	</style>
	{% endif -%}

</head>

<body>
